<Project>
  <!-- Security Updates for Orchard Core - make sure to check if these are still necessary -->
  <ItemGroup>
    <PackageReference Include="HtmlSanitizer"
                      Version="9.2.1039"
                      NoWarn="NU1510"
                      Condition="!@(PackageReference->AnyHaveMetadataValue('Identity', 'HtmlSanitizer'))" />
  </ItemGroup>
</Project>
