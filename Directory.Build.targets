<Project>
  <!-- Security Updates for Orchard Core - make sure to check if these are still necessary -->
  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" NoWarn="NU1510">
      <Version Condition="'$(ManagePackageVersionsCentrally)' != 'true'">9.2.1039</Version>
    </PackageReference>
  </ItemGroup>

  <Target Name="DeduplicatePackageReferences" BeforeTargets="ResolvePackageAssets">
    <!-- 1. Remove duplicate PackageReference items (matches on ItemSpec / Package ID) -->
    <RemoveDuplicates Inputs="@(PackageReference)">
      <Output TaskParameter="Filtered" ItemName="_UniquePackageReferences" />
    </RemoveDuplicates>

    <!-- 2. Replace the original PackageReference list with the deduplicated list -->
    <ItemGroup>
      <PackageReference Remove="@(PackageReference)" />
      <PackageReference Include="@(_UniquePackageReferences)" />
    </ItemGroup>
  </Target>
</Project>
