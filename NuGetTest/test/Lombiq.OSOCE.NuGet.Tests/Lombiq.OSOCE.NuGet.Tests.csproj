  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <!-- The published 2.1.0 SDK still includes VSTest dependencies. -->
    <PackageReference Remove="Microsoft.NET.Test.Sdk;xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Testing.Extensions.GitHubActionsReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Lombiq.HelpfulLibraries" />
    <PackageReference Include="Lombiq.EInvoiceValidator" />
    <PackageReference Include="Lombiq.EInvoiceValidator.Sample" />
  </ItemGroup>
</Project>
