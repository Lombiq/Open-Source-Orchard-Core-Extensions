@* Simplified version of the shape from TheThemes, to avoid specific HTML validation issues. *@
<li class="nav-item align-self-center me-3">
    <button type="button"
            class="dropdown-item"
            data-bs-theme-value="auto"
            aria-pressed="false"
            title="@T["Auto"]"
            aria-label="@T["Auto"]">
        <span class="theme-icon">
            <i class="fa-solid fa-circle-half-stroke"></i>
        </span>
    </button>
</li>
<li class="nav-item align-self-center me-3">
    <button type="button"
            class="dropdown-item active"
            data-bs-theme-value="light"
            aria-pressed="true"
            title="@T["Light"]"
            aria-label="@T["Light"]">
        <span class="theme-icon">
            <i class="fa-solid fa-sun"></i>
        </span>
    </button>
</li>
<li class="nav-item align-self-center me-3">
    <button type="button" class="dropdown-item" data-bs-theme-value="dark" aria-pressed="false" title="@T["Dark"]" aria-label="@T["Dark"]">
        <span class="theme-icon">
            <i class="fa-solid fa-moon"></i>
        </span>
    </button>
</li>
